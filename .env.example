# 复制为 .env 后按本机环境修改；.env 不提交到仓库。
# Web 应用
APP_SECRET_KEY=请替换为随机字符串
APP_SESSION_SECONDS=3600
APP_LOG_DIR=logs
APP_LOG_LEVEL=INFO

# SQL Server 连接
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=.\SQLEXPRESS
DB_DATABASE=ConvenienceStoreDB
# Windows 身份验证（推荐）：保持 DB_TRUSTED_CONNECTION=true
DB_TRUSTED_CONNECTION=true
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=5

# 按角色收敛权限的应用账号（与 sql/migration.sql 创建的一致）
DB_APP_USER_AUTH=app_auth
DB_APP_USER_CUSTOMER=app_customer
DB_APP_USER_CASHIER=app_cashier
DB_APP_USER_INVENTORY=app_inventory
DB_APP_USER_MANAGER=app_manager

# 积分规则
POINTS_PER_YUAN=1
POINTS_PER_DISCOUNT_YUAN=10
